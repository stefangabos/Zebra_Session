<?xml version="1.0"?>
<ruleset name="Zebra_Session PHP compatibility">

    <description>Checks the library against the oldest PHP version it claims to support.</description>

    <!--
        Only the library itself, because only the library ships. The suite is still limited to what PHPUnit
        9.6 and PHP 7.3 understand, since it has to run on the floor declared in composer.json; the older
        5.6.40 claim is covered by "composer check-compat-legacy" and by tests/run-legacy.sh.

        The path is relative to THIS file, not to where phpcs is run from - so it needs the "../" while the
        ruleset lives in tests/. The installed_paths below is the other way round, relative to the working
        directory, which is why it has no "../".
    -->
    <file>../Zebra_Session.php</file>

    <!-- so that the standard below can be referred to by name -->
    <config name="installed_paths" value="vendor/phpcompatibility/php-compatibility"/>

    <!--
        The floor declared in composer.json - the oldest PHP the suite is actually run on rather than the
        oldest PHPUnit 9.6 would tolerate, which is 7.3.

        The library itself works on 5.6.40, which "composer check-compat-legacy" checks by running this same
        ruleset against 5.6-, and tests/run-legacy.sh by linting and smoke-testing on a real PHP 5.6.40.
    -->
    <config name="testVersion" value="7.4-"/>

    <rule ref="PHPCompatibility"/>

</ruleset>
