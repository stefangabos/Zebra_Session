<?xml version="1.0"?>
<ruleset name="Zebra_Session PHP compatibility">

    <description>Checks the library against the oldest PHP version it claims to support.</description>

    <!-- only the library itself - the test suite needs PHP 8.1 or newer and is never shipped to anyone -->
    <file>Zebra_Session.php</file>

    <!-- so that the standard below can be referred to by name -->
    <config name="installed_paths" value="vendor/phpcompatibility/php-compatibility"/>

    <!--
        the version the library requires is 5.5.2, but PHPCompatibility only understands major.minor, so the check runs
        against 5.5 and the one difference between the two is excluded below
    -->
    <config name="testVersion" value="5.5-"/>

    <rule ref="PHPCompatibility"/>

    <!--
        session.use_strict_mode was added in PHP 5.5.2 - which is precisely the version the library requires, and the
        reason that is the minimum in the first place. The warning is only true of 5.5.0 and 5.5.1, both of which are
        below the supported floor.
    -->
    <rule ref="PHPCompatibility.IniDirectives.NewIniDirectives.session_use_strict_modeFound">
        <severity>0</severity>
    </rule>

</ruleset>
